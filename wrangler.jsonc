{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "beauty-app",
  "preview_urls": true,
  "compatibility_date": "2026-10-07",
  "previews": {},
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "my-beauty-palette.com",
      "custom_domain": true
    }
  ]
}
