---
import Layout from '../../layouts/Layout.astro';
import Sources from '../../components/Sources.astro';
import { publishedIngredients, pathTo, categoryLabel, formatDate } from '../../lib/content';
import type { CollectionEntry } from 'astro:content';
export async function getStaticPaths() { return (await publishedIngredients()).map((entry) => ({ params: { id: entry.id }, props: { entry } })); }
interface Props { entry: CollectionEntry<'ingredients'>; }
const { entry } = Astro.props;
---
<Layout title={entry.data.title} description={entry.data.summary} active="ingredients"><article class="detail"><div class="breadcrumb"><a href={pathTo()}>ホーム</a><span>/</span><a href={pathTo('ingredients/')}>成分図鑑</a><span>/</span><span>{entry.data.title}</span></div><header class="detail-header"><p class="eyebrow">INGREDIENT NOTE</p><p class="english-name">{entry.data.englishName}</p><h1>{entry.data.title}</h1><div class="detail-meta"><span>{categoryLabel[entry.data.category]}</span><span>{entry.data.role}</span><time datetime={entry.data.updatedAt}>更新 {formatDate(entry.data.updatedAt)}</time></div><p>{entry.data.summary}</p><div class="detail-tags">{entry.data.tags.map((tag) => <a href={`${pathTo('search/')}?q=${encodeURIComponent(tag)}`}># {tag}</a>)}</div></header><div class="detail-body">{entry.data.sections.map((section) => <section><h2>{section.heading}</h2><p>{section.body}</p></section>)}</div><aside class="detail-note"><h2>選ぶときに知っておきたいこと</h2><p>{entry.data.caution}</p></aside><Sources sources={entry.data.sources} /><div class="detail-back"><a class="text-link" href={pathTo('ingredients/')}>← 成分図鑑にもどる</a></div></article></Layout>
