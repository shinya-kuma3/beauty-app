---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import FilterTabs from '../../components/FilterTabs.astro';
import { publishedArticles, pathTo } from '../../lib/content';
const entries = await publishedArticles();
---
<Layout title="ケア記事" active="articles"><div class="shell"><header class="page-header"><div class="breadcrumb"><a href={pathTo()}>ホーム</a><span>/</span><span>ケア記事</span></div><p class="eyebrow">CARE JOURNAL</p><h1><span>日々のケアに、</span><span>小さなヒント。</span></h1><p>肌と髪の基本を学ぶ、読みもの。自分に合うケアを考えるきっかけに。</p></header><section class="listing" aria-label="ケア記事一覧"><FilterTabs /><div class="article-grid">{entries.map((entry, index) => <div data-list-category={entry.data.category}><ArticleCard entry={entry} index={index} /></div>)}</div><p class="empty-state" data-list-empty hidden>このカテゴリの記事は、現在準備中です。</p><div class="detail-back"><a class="text-link" href={pathTo('search/')}>ケアのキーワードで検索する →</a></div></section></div></Layout>
