---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { publishedArticles, pathTo } from '../../lib/content';
import { tagPickerMarkup } from '../../lib/tag-picker-markup.mjs';
const entries = await publishedArticles();
const searchRecords=entries.map(entry=>({id:entry.id,title:entry.data.title,summary:entry.data.summary,tags:entry.data.tags,areas:entry.data.areas||[entry.data.category],updatedAt:entry.data.updatedAt,body:[entry.data.bodyMarkdown||'',...entry.data.sections.map(s=>s.heading+' '+s.body)].join(' ')}));
const searchData=JSON.stringify(searchRecords).replace(/</g,'\u003c');
---
<Layout title="ケア記事" active="articles">
<link rel="stylesheet" href={pathTo('tag-picker.css')} />
<div class="shell"><header class="page-header"><div class="breadcrumb"><a href={pathTo()}>ホーム</a><span>/</span><span>ケア記事</span></div><p class="eyebrow">CARE JOURNAL</p><h1><span>日々のケアに、</span><span>小さなヒント。</span></h1><p>肌・髪・爪・身体の基本を学ぶ、読みもの。自分に合うケアを考えるきっかけに。</p></header>
<section class="journal-search" data-article-search-panel hidden aria-label="記事を探す"><form id="public-article-filters"><label for="public-query">キーワード<input id="public-query" name="q" type="search" maxlength="500" placeholder="例：セラミド 保湿 乾燥肌" /></label><p class="journal-search-hint">キーワードは空白で区切って入力してください。</p><details><summary>詳しい条件で探す</summary><div class="journal-filter-grid">
<div><label for="public-keyword-mode">キーワードの含め方<select id="public-keyword-mode" name="keyword_mode"><option value="all">すべて含む</option><option value="any">いずれかを含む</option></select></label><label for="public-exclude">含めないキーワード<input id="public-exclude" name="exclude" type="search" maxlength="500" placeholder="例：香料 アルコール" /></label><label for="public-scope">キーワードの検索対象<select id="public-scope" name="scope"><option value="content">タイトル・紹介文・本文・タグ</option><option value="title">タイトルのみ</option><option value="body">本文のみ</option></select></label><fieldset class="journal-areas"><legend>部位（複数選択＝いずれか）</legend>{[{value:'skin',label:'肌'},{value:'hair',label:'髪'},{value:'nail',label:'爪'},{value:'body',label:'身体'}].map(area=><label><input type="checkbox" name="category" value={area.value} />{area.label}</label>)}</fieldset></div>
<div><Fragment set:html={tagPickerMarkup('article-tags')} /><label for="public-tag-mode">選んだタグの含め方<select id="public-tag-mode" name="tag_mode"><option value="or">いずれかを含む</option><option value="and">すべて含む</option></select></label><p class="journal-search-hint">公開されている記事のタグから選べます。</p><label for="public-sort">並び順<select id="public-sort" name="sort"><option value="newest">更新日の新しい順</option><option value="oldest">更新日の古い順</option></select></label></div>
<div><label for="public-month">更新年月<input id="public-month" name="month" type="month" /></label><label for="public-from">更新期間の開始日<input id="public-from" name="from" type="date" /></label><label for="public-to">更新期間の終了日<input id="public-to" name="to" type="date" /></label><p class="journal-search-hint">終了日を含みます。年月と期間を指定すると、両方に当てはまる記事を探します。</p></div></div></details><div class="journal-search-actions"><button type="submit">検索する</button><button type="button" id="public-reset-search">条件をリセット</button></div><p id="public-search-message" role="status" aria-live="polite" class="journal-search-hint"></p></form></section>
<section class="listing" aria-label="ケア記事一覧"><p id="public-article-count" class="result-count" aria-live="polite">{entries.length}件の記事</p><div class="article-grid" data-article-grid>{entries.map((entry, index) => <div data-article-id={entry.id}><ArticleCard entry={entry} index={index} /></div>)}</div><p class="empty-state" id="public-article-empty" hidden>条件に一致する記事はありません。別のキーワードや条件で探してみてください。</p><noscript><p class="journal-search-hint">詳細検索にはJavaScriptが必要です。公開済みの記事は、この一覧から読むことができます。</p></noscript><div class="detail-back"><a class="text-link" href={pathTo('search/')}>成分とケア記事をまとめて検索する →</a></div></section></div>
<script id="article-search-data" type="application/json" set:html={searchData} />
<script src={pathTo('tag-picker.js')} is:inline defer></script><script src={pathTo('article-listing.js')} is:inline defer></script>
</Layout>
<style>
.journal-search { padding:28px; border:1px solid var(--line); border-radius:10px; background:#f7fbfe; }
.journal-search label { display:block; font-size:13px; margin:18px 0 10px; }
.journal-search input:not([type=checkbox]),.journal-search select { display:block; width:100%; margin-top:8px; border:1px solid #bdd3e4; border-radius:5px; background:white; color:var(--ink); padding:12px; }
.journal-search :is(input,select,button):focus-visible { outline-width:2px; outline-offset:0; }
.journal-search-hint { font-size:12px; color:var(--muted); margin:10px 0; }
.journal-search details { border-block:1px solid var(--line); padding:18px 0; margin-top:18px; }
.journal-search summary { cursor:pointer; color:var(--blue); font-size:14px; }
.journal-filter-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:28px; }
.journal-areas { border:0; padding:0; margin:22px 0; display:flex; flex-wrap:wrap; gap:12px; font-size:13px; }
.journal-areas legend { margin-bottom:12px; }.journal-areas label { margin:0; display:flex; align-items:center; gap:6px; }
.journal-areas input { width:16px; height:16px; accent-color:var(--blue); }
.journal-search-actions { display:flex; gap:12px; flex-wrap:wrap; margin:20px 0 4px; }
.journal-search-actions button { padding:12px 20px; background:white; border:1px solid #bdd3e4; border-radius:5px; color:var(--blue); }
.journal-search-actions button[type=submit] { background:var(--navy); border-color:var(--navy); color:white; }
#public-article-count { margin-bottom:20px; }
@media(max-width:800px) { .journal-filter-grid { grid-template-columns:1fr; gap:0; }.journal-search { padding:20px; } }
</style>
