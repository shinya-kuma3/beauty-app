---
import Layout from '../../layouts/Layout.astro';
import Sources from '../../components/Sources.astro';
import { publishedArticles, publishedIngredients, pathTo, categoryLabel, formatDate } from '../../lib/content';
import type { CollectionEntry } from 'astro:content';
export async function getStaticPaths() { return (await publishedArticles()).map((entry) => ({ params: { id: entry.id }, props: { entry } })); }
interface Props { entry: CollectionEntry<'articles'>; }
const { entry } = Astro.props;
const related = (await publishedIngredients()).filter((item) => entry.data.relatedIngredients.includes(item.id));
---
<Layout title={entry.data.title} description={entry.data.summary} active="articles"><article class="detail"><div class="breadcrumb"><a href={pathTo()}>ホーム</a><span>/</span><a href={pathTo('articles/')}>ケア記事</a><span>/</span><span>{entry.data.title}</span></div><header class="detail-header"><p class="eyebrow">CARE JOURNAL</p><h1>{entry.data.title}</h1><div class="detail-meta"><span>{categoryLabel[entry.data.category]}</span><span>{entry.data.readingMinutes}分で読む</span><time datetime={entry.data.updatedAt}>更新 {formatDate(entry.data.updatedAt)}</time></div><p>{entry.data.summary}</p><div class="detail-tags">{entry.data.tags.map((tag) => <a href={`${pathTo('search/')}?q=${encodeURIComponent(tag)}`}># {tag}</a>)}</div></header><div class="detail-body">{entry.data.sections.map((section) => <section><h2>{section.heading}</h2><p>{section.body}</p></section>)}</div>{related.length > 0 && <aside class="related"><h2>あわせて知りたい成分</h2><div class="related-links">{related.map((item) => <a href={pathTo(`ingredients/${item.id}/`)}>{item.data.title} →</a>)}</div></aside>}<Sources sources={entry.data.sources} /><div class="detail-back"><a class="text-link" href={pathTo('articles/')}>← ケア記事にもどる</a></div></article></Layout>
