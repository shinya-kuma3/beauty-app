---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import IngredientCard from '../components/IngredientCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { publishedIngredients, publishedArticles, pathTo } from '../lib/content';
const [ingredients, articles] = await Promise.all([publishedIngredients(), publishedArticles()]);
const featuredIngredients = ['ceramide', 'hyaluronic-acid', 'petrolatum'].map(id => ingredients.find(entry => entry.id === id)!).filter(Boolean);
const featuredArticles = ['moisturizer-basics', 'nail-care-basics', 'body-moisturizing-basics'].map(id => articles.find(entry => entry.id === id)!).filter(Boolean);
---
<Layout>
  <section class="shell hero"><div class="hero-copy"><p class="eyebrow"><span></span> A LITTLE KNOWLEDGE, A BETTER CARE.</p><h1>私らしい、<br />ケアの<span class="serif-blue">彩り</span>を。</h1><p class="hero-description">いまの自分に、心地よいケアを。<br />美容成分とケアの基本を、ひとつずつ知っていく。</p><div class="hero-actions"><a class="button primary" href={pathTo('ingredients/')}>成分図鑑をひらく<Icon name="arrow" size={18} /></a><a class="text-link" href={pathTo('articles/')}>ケア記事を読む<Icon name="arrow" size={18} /></a></div><div class="hero-footnote"><span class="small-circle"><Icon name="book" size={16} /></span>出典とともに、わかりやすく。</div></div><div class="hero-visual" aria-hidden="true"><div class="visual-orbit orbit-one"></div><div class="visual-orbit orbit-two"></div><div class="visual-sun"></div><div class="visual-label">THE BEAUTY OF<br /><span>knowing.</span></div><div class="bottle bottle-main"><div class="bottle-cap"></div><div class="bottle-label"><span>my palette</span><i>clear & calm</i><small>DAILY KNOWLEDGE</small></div></div><div class="bottle bottle-small"><div class="bottle-cap"></div><div class="bottle-label"><span>care.</span><small>YOUR DAILY CARE</small></div></div><div class="visual-caption"><span>01 — KNOW YOUR CARE</span><span>肌・髪・爪・身体を、もっと知る。</span></div></div></section>
  <section class="discovery-section"><div class="shell discovery"><div><p class="eyebrow">FIND YOUR CARE</p><h2>気になることから、探してみる。</h2></div><div class="discovery-search"><form class="search-form" action={pathTo('search/')}><Icon name="search" size={21} /><label class="sr-only" for="home-search">成分・キーワード</label><input id="home-search" name="q" type="search" placeholder="成分名や、ケアのキーワード" /><button type="submit">検索<Icon name="arrow" size={17} /></button></form><div class="suggested"><span>キーワード例</span>{['保湿', 'セラミド', 'ヘアケア'].map((tag) => <a href={`${pathTo('search/')}?q=${encodeURIComponent(tag)}`}>{tag}</a>)}</div></div></div></section>
  <section class="shell section"><div class="section-heading"><div><p class="eyebrow">INGREDIENT LIBRARY</p><h2>成分を知る、ケアが変わる。</h2><p>名前だけではわからない、役割と選ぶときのヒント。</p></div><a class="text-link" href={pathTo('ingredients/')}>成分図鑑をすべて見る<Icon name="arrow" size={18} /></a></div><div class="ingredient-grid">{featuredIngredients.map((entry, index) => <IngredientCard entry={entry} index={index} />)}</div></section>
  <section class="shell palette-invite"><div class="palette-mark" aria-hidden="true"><Icon name="sparkle" size={34} /><span></span><span></span><span></span></div><div><p class="eyebrow">YOUR INGREDIENT PALETTE</p><h2>いまのあなたに、どんな成分？</h2><p>3つの質問で、ケアのヒントを見つけましょう。</p></div><a class="button primary" href={pathTo('finder/')}>成分診断をはじめる<Icon name="arrow" size={18} /></a></section>
  <section class="shell topic-links" aria-label="ケアのテーマ"><a href={`${pathTo('search/')}?category=skin`}><span class="topic-icon"><Icon name="face" size={28} /></span><div><small>SKIN CARE</small><h3>肌を、すこやかに。</h3><p>うるおい・保湿・毎日のスキンケア</p></div><Icon name="arrow" size={23} /></a><a href={`${pathTo('search/')}?category=hair`}><span class="topic-icon"><Icon name="hair" size={28} /></span><div><small>HAIR CARE</small><h3>髪に、心地よさを。</h3><p>洗い方・頭皮・毎日のヘアケア</p></div><Icon name="arrow" size={23} /></a><a href={`${pathTo('search/')}?category=nail`}><span class="topic-icon"><Icon name="nail" size={28} /></span><div><small>NAIL CARE</small><h3>指先まで、心地よく。</h3><p>爪まわりの保湿・ネイル後のケア</p></div><Icon name="arrow" size={23} /></a><a href={`${pathTo('search/')}?category=body`}><span class="topic-icon"><Icon name="body" size={28} /></span><div><small>BODY CARE</small><h3>身体にも、うるおいを。</h3><p>入浴後の保湿・乾燥・毎日の習慣</p></div><Icon name="arrow" size={23} /></a></section>
  <section class="shell section"><div class="section-heading"><div><p class="eyebrow">CARE JOURNAL</p><h2>日々のケアに、小さなヒント。</h2><p>肌・髪・爪・身体の基本を、気軽に読めるノートに。</p></div><a class="text-link" href={pathTo('articles/')}>ケア記事をすべて見る<Icon name="arrow" size={18} /></a></div><div class="article-grid">{featuredArticles.map((entry, index) => <ArticleCard entry={entry} index={index} />)}</div></section>
  <section class="shell philosophy"><span class="philosophy-icon"><Icon name="sparkle" size={30} /></span><div><p class="eyebrow">OUR NOTE</p><h2>自分のケアを、自分で選べるように。</h2><p>話題の成分も、定番のケアも。情報の出典や背景をたどりながら、<br class="desktop-break" />あなたにとっての心地よさを見つけるお手伝いをします。</p></div><a class="text-link" href={pathTo('about/')}>このサイトについて<Icon name="arrow" size={18} /></a></section>
</Layout>
