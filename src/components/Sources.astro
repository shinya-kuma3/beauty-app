---
interface Props { sources: { title: string; url: string; kind: string }[]; }
const { sources } = Astro.props;
const labels: Record<string, string> = { guideline: '専門団体の情報', research: '研究・論文', official: '公式情報', x: 'X の投稿' };
---
<aside class="sources" aria-label="参考資料"><h2>出典・参考資料</h2><ul>{sources.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a><small>{labels[source.kind]} · 外部サイトを開きます</small></li>)}</ul></aside>
