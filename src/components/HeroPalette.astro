---
import { pathTo } from '../lib/content';
const scenes=[{id:'skin',name:'肌',title:'clear & calm.',note:'うるおいを、毎日の習慣に。'},{id:'hair',name:'髪',title:'softly in flow.',note:'髪に、やさしい流れを。'},{id:'nail',name:'爪',title:'care to the tips.',note:'小さな指先にも、いたわりを。'},{id:'body',name:'身体',title:'a moment to reset.',note:'身体を包む、心地よい時間。'},{id:'palette',name:'成分',title:'your own palette.',note:'知ることから、自分らしいケアへ。'}];
---
<div class="hero-visual hero-carousel" data-hero-carousel aria-label="ケアの5つの彩り">
 {scenes.map((scene,index)=><div class:list={['hero-scene','scene-'+scene.id,{'is-active':index===0}]} data-scene aria-hidden={index!==0} inert={index!==0}>
 <div class="hero-scene-orbit" aria-hidden="true"></div><div class="hero-scene-heading"><span>THE BEAUTY OF KNOWING</span><strong>{scene.title}</strong></div>
 <svg class="hero-art" viewBox="0 0 500 400" fill="none" aria-hidden="true">
 <defs><linearGradient id={'glass-'+scene.id} x1="120" y1="100" x2="350" y2="390" gradientUnits="userSpaceOnUse"><stop stop-color="white" stop-opacity=".95"/><stop offset="1" stop-color="#d7edf7" stop-opacity=".5"/></linearGradient><linearGradient id={'blue-'+scene.id} x1="100" y1="70" x2="400" y2="360" gradientUnits="userSpaceOnUse"><stop stop-color="#f5fbff"/><stop offset=".5" stop-color="#91bed7"/><stop offset="1" stop-color="#5188ad"/></linearGradient><radialGradient id={'pearl-'+scene.id}><stop stop-color="white"/><stop offset=".6" stop-color="#e8f3fa"/><stop offset="1" stop-color="#9abbd3"/></radialGradient></defs>
 <ellipse cx="275" cy="353" rx="140" ry="18" fill="#457b9d" opacity=".12"/>
 {scene.id==='skin'&&<g><rect x="195" y="129" width="125" height="215" rx="27" fill={'url(#glass-'+scene.id+')'} stroke="white"/><rect x="218" y="99" width="79" height="35" rx="5" fill="#608ca8"/><path d="M217 140V308" stroke="white" stroke-opacity=".8" stroke-width="7" stroke-linecap="round"/><rect x="210" y="213" width="95" height="78" rx="2" fill="white" fill-opacity=".65"/><text x="257" y="248" text-anchor="middle" fill="#3d6381" font-size="13" font-family="serif">my palette</text><text x="257" y="268" text-anchor="middle" fill="#6b8da5" font-size="8">DAILY CARE</text><rect x="335" y="217" width="68" height="125" rx="17" fill={'url(#glass-'+scene.id+')'} stroke="white"/><rect x="350" y="196" width="38" height="26" rx="4" fill="#7fa4b8"/><path d="M112 225C112 225 90 257 90 272A22 22 0 00134 272C134 257 112 225 112 225Z" fill="white" fill-opacity=".4"/></g>}
 {scene.id==='hair'&&<g class="hair-illustration">
 <path d="M161 195C157 126 190 82 244 83C302 82 333 124 329 193C324 245 333 296 383 322C335 354 287 336 261 301C230 354 169 358 124 326C163 298 171 248 161 195Z" fill={'url(#blue-'+scene.id+')'} stroke="#668fae" stroke-opacity=".35" stroke-width="1.5"/>
 <path d="M244 88C217 112 212 165 220 221C227 267 213 310 186 333" stroke="#f7fcff" stroke-opacity=".75" stroke-width="3" stroke-linecap="round"/>
 {Array.from({length:21},(_,i)=>{const x=166+i*7.7;const left=i<10;const end=left?131+i*10:266+(i-10)*10;return <path d={'M'+x+' '+(148-Math.sin(i/20*Math.PI)*53)+'C'+(x-18)+' 178 '+(x+(left?19:-14))+' 222 '+x+' 261C'+(x+(left?-4:2))+' 295 '+(end+(left?24:-27))+' 321 '+end+' '+(329+Math.sin(i*.8)*7)} stroke={i%3===0?'#ffffff':'#527fa1'} stroke-opacity={i%3===0?'.58':'.24'} stroke-width={i%3===0?'1.8':'1.1'} stroke-linecap="round"/>;})}
 <path d="M179 164C181 124 198 104 221 98M295 118C308 141 313 166 310 199" stroke="white" stroke-width="7" stroke-opacity=".25" stroke-linecap="round"/>
 </g>}
 {scene.id==='nail'&&<g><path d="M157 341V221C157 144 260 144 260 221V341" fill={'url(#glass-'+scene.id+')'} stroke="white" stroke-width="2"/><path d="M177 218C177 166 240 166 240 218V247C240 289 177 289 177 247Z" fill={'url(#blue-'+scene.id+')'} stroke="white" stroke-width="2"/><path d="M291 341V255C291 200 367 200 367 255V341" fill={'url(#glass-'+scene.id+')'} stroke="white"/><path d="M306 255C306 219 352 219 352 255V277C352 305 306 305 306 277Z" fill="#eef7fc" stroke="white"/><circle cx="370" cy="161" r="26" fill={'url(#pearl-'+scene.id+')'}/><path d="M128 152L133 166L147 171L133 176L128 190L123 176L109 171L123 166Z" fill="white"/></g>}
 {scene.id==='body'&&<g><path d="M99 318C178 123 233 82 413 124C328 193 424 276 336 342C242 372 186 285 99 318Z" fill={'url(#blue-'+scene.id+')'}/><path d="M108 316C245 240 212 145 405 130M147 325C270 269 226 176 375 158M190 333C301 298 269 234 364 191" stroke="white" stroke-opacity=".45" stroke-width="2"/><path d="M126 163C126 163 94 205 94 224A32 32 0 00158 224C158 205 126 163 126 163Z" fill={'url(#glass-'+scene.id+')'} stroke="white"/><circle cx="364" cy="295" r="33" fill={'url(#pearl-'+scene.id+')'}/></g>}
 {scene.id==='palette'&&<g><ellipse cx="259" cy="251" rx="132" ry="78" transform="rotate(-24 259 251)" fill={'url(#glass-'+scene.id+')'} stroke="white" stroke-width="2"/><ellipse cx="205" cy="266" rx="22" ry="14" transform="rotate(-24 205 266)" fill="#a7cddd"/><circle cx="224" cy="168" r="43" fill={'url(#pearl-'+scene.id+')'}/><circle cx="316" cy="213" r="36" fill="#b9d6ec"/><circle cx="269" cy="275" r="28" fill="#c6c5e1"/><circle cx="348" cy="280" r="21" fill="#a3cdc9"/><path d="M118 134L124 151L141 157L124 163L118 180L112 163L95 157L112 151Z" fill="white"/></g>}
 </svg><div class="hero-scene-caption"><span>{String(index+1).padStart(2,'0')} — {scene.name.toUpperCase()}</span><span>{scene.note}</span></div>
 </div>)}
 <div class="hero-seek" aria-hidden="true">{scenes.map((_,index)=><span class:list={['hero-seek-segment',{'is-active':index===0}]} data-hero-progress><i></i></span>)}</div>
</div>
<script is:inline src={pathTo('hero-carousel.js')} defer></script>
