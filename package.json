{
  "name": "beauty-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4325",
    "build": "npm run validate:content && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4325",
    "check": "astro check",
    "validate:content": "node scripts/validate-content.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:build": "node scripts/verify-build.mjs"
  },
  "dependencies": { "astro": "7.3.6" },
  "devDependencies": { "@astrojs/check": "0.9.10", "typescript": "~5.9.3", "wrangler": "^4.148.0" },
  "engines": { "node": ">=22.19.0" }
}
